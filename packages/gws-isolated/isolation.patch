+#[cfg(test)]
+mod isolated_tests {
+    use super::*;
+    use tempfile::tempdir;
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn isolated_ignores_inherited_token_credentials_and_adc() {
+        let dir = tempdir().unwrap();
+        let adc = dir.path().join("adc.json");
+        std::fs::write(&adc, r#"{"type":"authorized_user","client_id":"fake","client_secret":"fake","refresh_token":"fake","quota_project_id":"poison"}"#).unwrap();
+        std::env::set_var("GOOGLE_WORKSPACE_CLI_CONFIG_DIR", dir.path());
+        std::env::set_var("GOOGLE_WORKSPACE_CLI_TOKEN", "poison");
+        std::env::set_var("GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE", &adc);
+        std::env::set_var("GOOGLE_APPLICATION_CREDENTIALS", &adc);
+        std::env::set_var("GOOGLE_WORKSPACE_PROJECT_ID", "poison");
+        assert!(get_token(&[]).await.unwrap_err().to_string().contains("Isolated gws"));
+        assert_eq!(get_quota_project(), None);
+        for key in ["GOOGLE_WORKSPACE_CLI_CONFIG_DIR", "GOOGLE_WORKSPACE_CLI_TOKEN", "GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE", "GOOGLE_APPLICATION_CREDENTIALS", "GOOGLE_WORKSPACE_PROJECT_ID"] {
+            std::env::remove_var(key);
+        }
+    }
+
+    #[tokio::test]
+    #[serial_test::serial]
+    async fn isolated_corrupt_encrypted_stops_and_preserves_files() {
+        let dir = tempdir().unwrap();
+        let enc = dir.path().join("credentials.enc");
+        let plain = dir.path().join("credentials.json");
+        std::fs::write(&enc, b"broken").unwrap();
+        std::fs::write(&plain, r#"{"type":"authorized_user","client_id":"fake","client_secret":"fake","refresh_token":"fake"}"#).unwrap();
+        let result = load_credentials_inner(None, &enc, &plain).await;
+        assert!(result.is_err());
+        assert_eq!(std::fs::read(&enc).unwrap(), b"broken");
+        assert!(plain.exists());
+    }
+
+    #[tokio::test]
+    async fn isolated_plain_oauth_credentials_load() {
+        let dir = tempdir().unwrap();
+        let plain = dir.path().join("credentials.json");
+        std::fs::write(&plain, r#"{"type":"authorized_user","client_id":"fake","client_secret":"fake","refresh_token":"fake"}"#).unwrap();
+        let result = load_credentials_inner(None, &dir.path().join("missing.enc"), &plain).await;
+        assert!(matches!(result.unwrap(), Credential::AuthorizedUser(_)));
+    }
+}
